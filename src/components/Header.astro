---
import { company, navItems } from '../data/site';
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href.split('#')[0]);
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${company.name} — início`}>
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="brand-text"><small>refrigeração</small><strong>A. J. P.</strong></span>
    </a>

    <nav class="desktop-nav" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="header-cta" href="https://wa.me/5512996175371?text=Ol%C3%A1!%20Acessei%20o%20site%20da%20A.%20J.%20P.%20Refrigera%C3%A7%C3%A3o%20e%20gostaria%20de%20solicitar%20atendimento." target="_blank" rel="noreferrer">WhatsApp <span aria-hidden="true">↗</span></a>
    </nav>

    <details class="mobile-menu">
      <summary aria-label="Abrir menu">Menu</summary>
      <nav class="mobile-nav" aria-label="Navegação mobile">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href="https://wa.me/5512996175371?text=Ol%C3%A1!%20Acessei%20o%20site%20da%20A.%20J.%20P.%20Refrigera%C3%A7%C3%A3o%20e%20gostaria%20de%20solicitar%20atendimento." target="_blank" rel="noreferrer">Falar pelo WhatsApp ↗</a>
      </nav>
    </details>
  </div>
</header>
