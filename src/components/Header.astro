---
import { company, navItems, whatsAppUrl } from '../data/site';
const currentPath = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? currentPath === '/' : currentPath.startsWith(href.split('#')[0]);
const headerWhatsApp = whatsAppUrl(company.whatsappPrimary, 'Olá! Acessei o site da A. J. P. Refrigeração e gostaria de solicitar atendimento.');
---
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label={`${company.name} — início`}>
      <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="brand-text"><small>refrigeração</small><strong>A. J. P.</strong></span>
    </a>

    <nav class="desktop-nav" aria-label="Navegação principal">
      {navItems.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="header-cta" href={headerWhatsApp} target="_blank" rel="noreferrer">WhatsApp <span aria-hidden="true">↗</span></a>
    </nav>

    <details class="mobile-menu">
      <summary aria-label="Abrir menu">Menu</summary>
      <nav class="mobile-nav" aria-label="Navegação mobile">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
        <a href={headerWhatsApp} target="_blank" rel="noreferrer">Falar pelo WhatsApp ↗</a>
      </nav>
    </details>
  </div>
</header>
