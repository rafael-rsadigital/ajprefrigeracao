---
import SiteLayout from '../layouts/SiteLayout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import FAQ from './FAQ.astro';
import { company, serviceBySlug, whatsAppUrl } from '../data/site';
import type { Service } from '../data/site';

interface Props { service: Service }
const { service } = Astro.props;
const canonicalPath = `/${service.slug}/`;
const primaryWhatsApp = whatsAppUrl(company.whatsappPrimary, service.whatsappMessage);
const secondaryWhatsApp = whatsAppUrl(company.whatsappSecondary, service.whatsappMessage);
const breadcrumbs = [
  { label: 'Início', href: '/' },
  { label: 'Serviços', href: '/#servicos' },
  { label: service.shortTitle },
];
const jsonLd = [
  {
    '@type': 'Service',
    '@id': `${company.url}${canonicalPath}#service`,
    name: service.title,
    serviceType: service.title,
    description: service.description,
    url: `${company.url}${canonicalPath}`,
    provider: { '@id': `${company.url}/#organization` },
    areaServed: { '@type': 'City', name: company.city, containedInPlace: { '@type': 'State', name: 'São Paulo' } },
  },
  {
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.label, item: item.href ? `${company.url}${item.href}` : `${company.url}${canonicalPath}` })),
  },
  {
    '@type': 'FAQPage',
    mainEntity: service.faqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
  },
];
---
<SiteLayout
  title={`${service.title} em São José dos Campos | A. J. P. Refrigeração`}
  description={`${service.title} em São José dos Campos e região. Consulte a A. J. P. Refrigeração e solicite atendimento pelo WhatsApp.`}
  canonicalPath={canonicalPath}
  keywords={[`${service.title} em São José dos Campos`, service.shortTitle, 'A. J. P. Refrigeração', 'São José dos Campos']}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow">{service.eyebrow} · São José dos Campos</p>
      <h1>{service.title} em São José dos Campos</h1>
      <p class="lede">{service.summary}</p>
      <div class="hero-actions">
        <a class="button button--primary" href={primaryWhatsApp} target="_blank" rel="noreferrer">Solicitar atendimento <span aria-hidden="true">↗</span></a>
        <a class="button button--secondary" href="#duvidas">Perguntas frequentes</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container service-layout">
      <article class="service-content">
        {service.image && <figure class="service-detail-image"><img src={service.image.src} alt={service.image.alt} loading="lazy" width="1200" height="800" decoding="async" /></figure>}
        <p>{service.description}</p>
        <h2>Quando procurar {service.shortTitle.toLowerCase()}</h2>
        <ul class="fact-list">
          {service.problems.map((problem) => <li>{problem}</li>)}
        </ul>
        <h2>Informações para solicitar o serviço</h2>
        <p>Ao entrar em contato, informe a marca e o modelo do equipamento, descreva o que precisa e indique o bairro em São José dos Campos. Essas informações ajudam a entender a solicitação e verificar a disponibilidade do atendimento.</p>
      </article>
      <aside class="service-aside" aria-label="Contato e outros serviços">
        <div class="aside-card aside-card--accent">
          <h3>Solicite atendimento</h3>
          <p>Informe o equipamento, o serviço desejado e seu bairro em São José dos Campos.</p>
          <div class="hero-actions">
            <a class="button button--on-dark" href={primaryWhatsApp} target="_blank" rel="noreferrer">WhatsApp 1 ↗</a>
            <a class="button button--secondary" href={secondaryWhatsApp} target="_blank" rel="noreferrer">WhatsApp 2 ↗</a>
          </div>
        </div>
        <div class="aside-card">
          <h3>Outros serviços</h3>
          <ul class="bullet-list">
            {Object.values(serviceBySlug).filter((other) => other.slug !== service.slug).map((other) => <li><a href={`/${other.slug}/`}>{other.shortTitle}</a></li>)}
            <li><a href="/area-de-atendimento/">Área de atendimento</a></li>
          </ul>
        </div>
      </aside>
    </div>
  </section>

  <section class="section section--tint" id="duvidas">
    <div class="container split split--equal">
      <div><h2>Perguntas frequentes</h2></div>
      <FAQ items={service.faqs} />
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band__inner">
      <div>
        <h2>Precisa de {service.shortTitle.toLowerCase()}?</h2>
        <p>Entre em contato com a A. J. P. Refrigeração.</p>
      </div>
      <div class="cta-actions">
        <a class="button button--on-dark" href={primaryWhatsApp} target="_blank" rel="noreferrer">Abrir WhatsApp ↗</a>
        <a class="button button--secondary" href="/">Início</a>
      </div>
    </div>
  </section>
</SiteLayout>
