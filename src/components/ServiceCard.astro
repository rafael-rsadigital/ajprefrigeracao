---
import type { Service } from '../data/site';
interface Props { service: Service; index: number }
const { service, index } = Astro.props;
---
<article class={`service-card service-card--${service.accent}${service.image ? '' : ' service-card--text-only'}`}>
  {service.image && <img class="service-card__image" src={service.image.src} alt={service.image.alt} loading="lazy" width="800" height="520" decoding="async" />}
  <span class="service-card__number">0{index + 1} · {service.eyebrow}</span>
  <h3>{service.title}</h3>
  <p>{service.summary}</p>
  <a class="service-card__link" href={`/${service.slug}/`}>Ver detalhes <span aria-hidden="true">→</span></a>
</article>
