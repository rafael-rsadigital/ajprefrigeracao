---
import { company, services } from '../data/site';
---
<footer class="site-footer" id="contato">
  <div class="container">
    <div class="footer-grid">
      <div>
        <a class="brand" href="/" aria-label={`${company.name} — início`}>
          <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="brand-text"><small>atendimento externo</small><strong>A. J. P. Refrigeração</strong></span>
        </a>
        <p class="footer-copy">Instalação, manutenção e higienização de ar-condicionado, além de conserto de geladeiras e freezers em São José dos Campos e região.</p>
      </div>
      <div>
        <p class="footer-title">Serviços</p>
        <nav class="footer-links" aria-label="Serviços no rodapé">
          {services.map((service) => <a href={`/${service.slug}/`}>{service.shortTitle}</a>)}
        </nav>
      </div>
      <div>
        <p class="footer-title">Contato</p>
        <div class="footer-links">
          <a href="https://wa.me/5512996175371" target="_blank" rel="noreferrer">(12) 99617-5371</a>
          <a href="https://wa.me/5512988517684" target="_blank" rel="noreferrer">(12) 98851-7684</a>
          <a href={company.instagramUrl} target="_blank" rel="noreferrer">Instagram {company.instagramHandle}</a>
          <a href="/area-de-atendimento/">São José dos Campos — SP</a>
        </div>
      </div>
    </div>
    <div class="footer-bottom">
      <span>CNPJ {company.cnpj}</span>
      <span>Atendimento no endereço do cliente · <a href="/">ajprefrigeracao.com.br</a></span>
    </div>
  </div>
</footer>
