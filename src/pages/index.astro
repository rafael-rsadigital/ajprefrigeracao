---
import SiteLayout from '../layouts/SiteLayout.astro';
import ServiceCard from '../components/ServiceCard.astro';
import FAQ from '../components/FAQ.astro';
import { company, homepageFaqs, regions, services, whatsAppUrl } from '../data/site';

const primaryWhatsApp = whatsAppUrl(company.whatsappPrimary, 'Olá! Acessei o site da A. J. P. Refrigeração e gostaria de solicitar atendimento em São José dos Campos.');
const jsonLd = [
  ...services.map((service) => ({
    '@type': 'Service',
    '@id': `${company.url}/${service.slug}/#service`,
    name: service.title,
    serviceType: service.title,
    description: service.description,
    url: `${company.url}/${service.slug}/`,
    provider: { '@id': `${company.url}/#organization` },
    areaServed: { '@type': 'City', name: company.city, containedInPlace: { '@type': 'State', name: 'São Paulo' } },
  })),
  {
    '@type': 'FAQPage',
    mainEntity: homepageFaqs.map((item) => ({ '@type': 'Question', name: item.question, acceptedAnswer: { '@type': 'Answer', text: item.answer } })),
  },
];
---
<SiteLayout
  title="Ar-condicionado e refrigeração em São José dos Campos | AJP"
  description="Instalação, manutenção e higienização de ar-condicionado. Conserto de geladeiras e freezers em São José dos Campos e região. Fale com a A. J. P. Refrigeração."
  canonicalPath="/"
  keywords={['refrigeração em São José dos Campos', 'ar-condicionado em SJC', 'conserto de geladeira', 'conserto de freezer', 'A. J. P. Refrigeração']}
  jsonLd={jsonLd}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">A. J. P. Refrigeração · São José dos Campos</p>
        <h1 id="hero-title">Ar-condicionado e refrigeração em São José dos Campos</h1>
        <p class="lede">Instalação, manutenção e higienização de ar-condicionado. Conserto de geladeiras e freezers.</p>
        <div class="hero-actions">
          <a class="button button--primary" href={primaryWhatsApp} target="_blank" rel="noreferrer">Solicitar atendimento <span aria-hidden="true">↗</span></a>
          <a class="button button--secondary" href="#servicos">Ver serviços <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <div class="hero-visual" aria-label="Ilustração abstrata de fluxo de ar e refrigeração" role="img">
        <span class="float-label float-label--one">refrigeração · climatização</span>
        <div class="cooling-card">
          <div class="cooling-top"><span>AJP / REFRIGERAÇÃO</span><span class="cooling-status">SJC · SP</span></div>
          <div class="unit"><span class="unit-core" aria-hidden="true"></span><span class="air-lines" aria-hidden="true"><i></i><i></i><i></i></span></div>
          <div class="cooling-bottom"><div><strong>Ar-condicionado</strong><span>Instalação e manutenção</span></div><div><strong>Refrigeração</strong><span>Geladeiras e freezers</span></div></div>
        </div>
        <span class="float-label float-label--two">A. J. P. ↗</span>
      </div>
    </div>
  </section>

  <section class="section section--tint" id="sobre" aria-labelledby="sobre-title">
    <div class="container split">
      <div>
        <p class="section-kicker">Sobre a empresa</p>
        <h2 id="sobre-title">Serviços de refrigeração em São José dos Campos</h2>
      </div>
      <div class="section-copy">
        <p>A A. J. P. Refrigeração trabalha com instalação, manutenção e higienização de ar-condicionado, além de conserto de geladeiras e freezers.</p>
        <p>O atendimento abrange São José dos Campos e região. Para consultar disponibilidade, entre em contato pelo WhatsApp.</p>
      </div>
    </div>
  </section>

  <section class="section" id="servicos" aria-labelledby="servicos-title">
    <div class="container">
      <div class="section-head">
        <div class="section-heading">
          <p class="section-kicker">Serviços</p>
          <h2 id="servicos-title">Nossos serviços</h2>
        </div>
        <p>Escolha o serviço para ver os detalhes.</p>
      </div>
      <div class="grid-3">
        {services.map((service, index) => <ServiceCard service={service} index={index} />)}
      </div>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="process-title">
    <div class="container split split--equal">
      <div>
        <p class="section-kicker" style="color: #a9f0ce;">Contato</p>
        <h2 id="process-title" style="color: #fff;">Como solicitar atendimento</h2>
        <p class="lede" style="color: rgba(255,255,255,.68);">Entre em contato e informe o equipamento e o serviço que procura.</p>
      </div>
      <div class="steps">
        <div class="step"><span class="step__number">01</span><h3 style="color: #fff;">Escolha o serviço</h3><p>Instalação, manutenção, higienização ou conserto.</p></div>
        <div class="step"><span class="step__number">02</span><h3 style="color: #fff;">Envie os detalhes</h3><p>Informe o tipo de equipamento, o problema e o bairro.</p></div>
        <div class="step"><span class="step__number">03</span><h3 style="color: #fff;">Combine o atendimento</h3><p>A equipe confirma a disponibilidade e os próximos passos.</p></div>
      </div>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="area-title">
    <div class="container">
      <div class="section-head">
        <div class="section-heading">
          <p class="section-kicker">Região atendida</p>
          <h2 id="area-title">São José dos Campos e região</h2>
        </div>
        <p>Atendimento em diferentes regiões da cidade. Consulte seu bairro pelo WhatsApp.</p>
      </div>
      <div class="region-grid">
        {regions.map((region) => <div class="region-card"><h3>{region.label}</h3><ul>{region.places.slice(0, 4).map((place) => <li>{place}</li>)}</ul></div>)}
      </div>
      <div class="hero-actions"><a class="button button--secondary" href="/area-de-atendimento/">Ver bairros e regiões <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-title">
    <div class="container split split--equal">
      <div>
        <h2 id="faq-title">Perguntas frequentes</h2>
      </div>
      <FAQ items={homepageFaqs} />
    </div>
  </section>

  <section class="cta-band">
    <div class="container cta-band__inner">
      <div><h2>Precisa de um serviço de refrigeração?</h2><p>Fale com a A. J. P. Refrigeração pelo WhatsApp.</p></div>
      <div class="cta-actions"><a class="button button--on-dark" href={primaryWhatsApp} target="_blank" rel="noreferrer">Falar pelo WhatsApp ↗</a><a class="button button--secondary" href={company.instagramUrl} target="_blank" rel="noreferrer">Instagram ↗</a></div>
    </div>
  </section>
</SiteLayout>
