---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { company, regions, whatsAppUrl } from '../../data/site';

const breadcrumbs = [{ label: 'Início', href: '/' }, { label: 'Área de atendimento' }];
const primaryWhatsApp = whatsAppUrl(company.whatsappPrimary, 'Olá! Gostaria de consultar atendimento da A. J. P. Refrigeração para o meu bairro em São José dos Campos.');
const jsonLd = [{
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((item, index) => ({ '@type': 'ListItem', position: index + 1, name: item.label, item: item.href ? `${company.url}${item.href}` : `${company.url}/area-de-atendimento/` })),
}];
---
<SiteLayout
  title="Área de atendimento em São José dos Campos | A. J. P. Refrigeração"
  description="Veja as regiões e os bairros de São José dos Campos relacionados ao atendimento da A. J. P. Refrigeração. Consulte a disponibilidade pelo WhatsApp."
  canonicalPath="/area-de-atendimento/"
  keywords={['área de atendimento refrigeração SJC', 'técnico de ar-condicionado São José dos Campos', 'refrigeração São José dos Campos']}
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={breadcrumbs} />
      <p class="eyebrow">São José dos Campos · SP</p>
      <h1>Área de atendimento</h1>
      <p class="lede">A A. J. P. Refrigeração atende bairros das regiões Sul, Norte, Central, Oeste e Leste de São José dos Campos. Consulte a disponibilidade para seu endereço.</p>
      <div class="hero-actions"><a class="button button--primary" href={primaryWhatsApp} target="_blank" rel="noreferrer">Consultar atendimento ↗</a><a class="button button--secondary" href="/#servicos">Ver serviços</a></div>
    </div>
  </section>

  <section class="section section--tint">
    <div class="container">
      <div class="section-head"><div class="section-heading"><p class="section-kicker">Regiões e bairros</p><h2>Bairros de São José dos Campos</h2></div><p>Consulte pelo WhatsApp a disponibilidade para sua região.</p></div>
      <div class="region-grid">
        {regions.map((region) => <div class="region-card"><h3>{region.label}</h3><ul>{region.places.map((place) => <li>{place}</li>)}</ul></div>)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split split--equal">
      <div><p class="section-kicker">Atendimento</p><h2>Consulte seu bairro</h2></div>
      <div class="section-copy"><p>Envie seu bairro e informe qual serviço precisa: instalação, manutenção ou higienização de ar-condicionado, conserto de geladeira ou freezer.</p><div class="hero-actions"><a class="button button--primary" href={primaryWhatsApp} target="_blank" rel="noreferrer">Falar pelo WhatsApp ↗</a><a class="button button--secondary" href="/">Voltar ao início</a></div></div>
    </div>
  </section>
</SiteLayout>
